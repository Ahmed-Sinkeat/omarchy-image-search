#!/bin/bash

# Search a selected screen region with Google Lens.
#
# The capture never leaves the user-private XDG runtime directory. A throwaway
# local page re-creates it as a browser File and submits Google's own upload
# form, so the upload and the results share one browser session. A top-level
# form POST is exempt from CORS, which is why this works where an in-page
# fetch() and a bare curl upload both fail.

MODE=smart
PRIVATE=false
FREEZE_PID=""
CAPTURE_FILE=""
PAGE_FILE=""
HANDED_OFF=false
CURSOR_SETTING=""
CURSOR_CHANGED=false

# The browser must still be able to read the page after this script exits.
PAGE_TTL=${LENS_PAGE_TTL:-30}

notify_failure() {
  omarchy-notification-send -g "" -u critical "Visual search failed" "$1" || true
}

set_no_hardware_cursors() {
  hyprctl eval "hl.config({ cursor = { no_hardware_cursors = $1 } })" &>/dev/null ||
    hyprctl keyword cursor:no_hardware_cursors "$1" &>/dev/null
}

release_capture_state() {
  if [[ -n $FREEZE_PID ]]; then
    kill "$FREEZE_PID" 2>/dev/null || true
    FREEZE_PID=""
  fi

  if [[ $CURSOR_CHANGED == true ]]; then
    set_no_hardware_cursors "$CURSOR_SETTING" || true
    CURSOR_CHANGED=false
  fi
}

cleanup() {
  release_capture_state
  [[ -n $CAPTURE_FILE ]] && rm -f -- "$CAPTURE_FILE"
  [[ $HANDED_OFF == false && -n $PAGE_FILE ]] && rm -f -- "$PAGE_FILE"
}

trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

for arg in "$@"; do
  case $arg in
  --private) PRIVATE=true ;;
  smart | region | windows | fullscreen) MODE=$arg ;;
  *)
    echo "Usage: omarchy-capture-image-search [--private] [smart|region|windows|fullscreen]" >&2
    exit 2
    ;;
  esac
done

# Match the stock screenshot command: pressing another capture shortcut while
# a selector is already open dismisses that selector instead of stacking two.
pkill slurp && exit 0

CURSOR_SETTING=$(hyprctl getoption cursor:no_hardware_cursors -j 2>/dev/null | jq -r '.int // empty')
if [[ -n $CURSOR_SETTING ]] && set_no_hardware_cursors 0; then
  CURSOR_CHANGED=true
fi

{ read -r FREEZE_PID; read -r SELECTION; } < <(omarchy-capture-region "$MODE" --keep-freeze)
[[ -n ${SELECTION:-} ]] || exit 0

RUNTIME_DIR=${XDG_RUNTIME_DIR:-/tmp}
CAPTURE_FILE=$(mktemp --tmpdir="$RUNTIME_DIR" omarchy-image-search.XXXXXX.png) || {
  release_capture_state
  notify_failure "Could not create a temporary capture"
  exit 1
}

if ! grim -g "$SELECTION" "$CAPTURE_FILE" || [[ ! -s $CAPTURE_FILE ]]; then
  release_capture_state
  notify_failure "Could not capture the selected region"
  exit 1
fi

# The image is complete now; restore the desktop before doing any networking.
release_capture_state

if ! ENCODED=$(base64 -w0 "$CAPTURE_FILE"); then
  notify_failure "Could not encode the capture"
  exit 1
fi

PAGE_FILE=$(mktemp --tmpdir="$RUNTIME_DIR" omarchy-image-search.XXXXXX.html) || {
  notify_failure "Could not create the upload page"
  exit 1
}

{
  printf '<!doctype html><meta charset=utf-8><title>Google Lens</title>\n'
  printf '<body style="margin:0;background:#101010">\n'
  printf '<form id=f method=POST enctype="multipart/form-data" '
  printf 'action="https://lens.google.com/v3/upload?ep=ccm&s=&st=%s">' "$(date +%s%3N)"
  printf '<input type=file id=i name=encoded_image></form>\n<script>\n'
  printf 'const b=atob("%s"),u=new Uint8Array(b.length);\n' "$ENCODED"
  printf 'for(let n=0;n<b.length;n++)u[n]=b.charCodeAt(n);\n'
  printf 'const d=new DataTransfer();\n'
  printf 'd.items.add(new File([u],"capture.png",{type:"image/png"}));\n'
  printf 'i.files=d.files;f.submit();\n</script>\n'
} >"$PAGE_FILE"

# The page carries its own copy of the image; the PNG is no longer needed.
rm -f -- "$CAPTURE_FILE"
CAPTURE_FILE=""

if [[ $PRIVATE == true ]]; then
  BROWSER_ARGS=(--private --new-window "file://$PAGE_FILE")
else
  BROWSER_ARGS=(--new-window "file://$PAGE_FILE")
fi

if ! omarchy-launch-browser "${BROWSER_ARGS[@]}"; then
  notify_failure "Could not open the default browser"
  exit 1
fi

# ponytail: fixed grace period rather than watching the browser read the page.
# Raise LENS_PAGE_TTL if a cold browser start ever outruns it.
HANDED_OFF=true
setsid --fork sh -c 'sleep "$1"; rm -f -- "$2"' _ "$PAGE_TTL" "$PAGE_FILE" &>/dev/null
