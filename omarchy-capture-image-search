#!/bin/bash

# Search a selected screen region with Google Lens.
#
# The capture is created only in the user-private XDG runtime directory. Google
# receives it through its normal browser UI so the upload and results share one
# session; this avoids short-lived curl-generated result URLs.

MODE=smart
PRIVATE=false
FREEZE_PID=""
CAPTURE_FILE=""
CURSOR_SETTING=""
CURSOR_CHANGED=false
BROWSER_ADDRESS=""
CHOOSER_ADDRESS=""

notify_failure() {
  omarchy-notification-send -g "" -u critical "Visual search failed" "$1" || true
}

set_no_hardware_cursors() {
  hyprctl eval "hl.config({ cursor = { no_hardware_cursors = $1 } })" &>/dev/null ||
    hyprctl keyword cursor:no_hardware_cursors "$1" &>/dev/null
}

release_capture_state() {
  if [[ -n $FREEZE_PID ]]; then
    kill "$FREEZE_PID" 2>/dev/null || true
    FREEZE_PID=""
  fi

  if [[ $CURSOR_CHANGED == true ]]; then
    set_no_hardware_cursors "$CURSOR_SETTING" || true
    CURSOR_CHANGED=false
  fi
}

cleanup() {
  release_capture_state
  [[ -n $CAPTURE_FILE ]] && rm -f -- "$CAPTURE_FILE"
}

client_addresses() {
  hyprctl clients -j 2>/dev/null | jq -c '[.[].address]' 2>/dev/null || printf '[]\n'
}

new_browser_address() {
  local before=$1

  hyprctl clients -j 2>/dev/null | jq -r --argjson before "$before" '
    first(
      .[]
      | . as $client
      | select(($before | index($client.address)) == null)
      | select((.class // "") | test("xdg-desktop-portal"; "i") | not)
      | $client.address
    ) // empty
  ' 2>/dev/null
}

new_chooser_address() {
  local before=$1

  hyprctl clients -j 2>/dev/null | jq -r --argjson before "$before" '
    first(
      .[]
      | . as $client
      | select(($before | index($client.address)) == null)
      | select((.class // "") | test("xdg-desktop-portal|file.?chooser"; "i"))
      | $client.address
    ) // empty
  ' 2>/dev/null
}

window_title() {
  local address=$1

  hyprctl clients -j 2>/dev/null | jq -r --arg address "$address" '
    first(.[] | select(.address == $address) | .title) // empty
  ' 2>/dev/null
}

window_exists() {
  local address=$1

  hyprctl clients -j 2>/dev/null | jq -e --arg address "$address" '
    any(.[]; .address == $address)
  ' &>/dev/null
}

focus_window() {
  local address=$1

  hyprctl dispatch "hl.dsp.focus({ window = \"address:$address\" })" &>/dev/null ||
    hyprctl dispatch focuswindow "address:$address" &>/dev/null
}

activate_chooser_select() {
  local bus_reply a11y_address registry_children app_bus app_name
  local object_path name_reply accessible_name role_reply children action_reply
  local -a app_buses queue
  local queue_index=0

  command -v gdbus >/dev/null || return 1

  bus_reply=$(gdbus call --session \
    --dest org.a11y.Bus \
    --object-path /org/a11y/bus \
    --method org.a11y.Bus.GetAddress 2>/dev/null) || return 1
  a11y_address=${bus_reply#*\'}
  a11y_address=${a11y_address%%\'*}
  [[ -n $a11y_address ]] || return 1

  registry_children=$(gdbus call --address "$a11y_address" \
    --dest org.a11y.atspi.Registry \
    --object-path /org/a11y/atspi/accessible/root \
    --method org.a11y.atspi.Accessible.GetChildren 2>/dev/null) || return 1
  mapfile -t app_buses < <(
    printf '%s\n' "$registry_children" |
      grep -oE "':[0-9.]+'" |
      tr -d "'" |
      awk '!seen[$0]++'
  )

  for app_bus in "${app_buses[@]}"; do
    app_name=$(gdbus call --address "$a11y_address" \
      --dest "$app_bus" \
      --object-path /org/a11y/atspi/accessible/root \
      --method org.freedesktop.DBus.Properties.Get \
      org.a11y.atspi.Accessible Name 2>/dev/null) || continue
    if [[ $app_name == *xdg-desktop-portal-gtk* ]]; then
      break
    fi
    app_bus=""
  done
  [[ -n $app_bus ]] || return 1

  queue=(/org/a11y/atspi/accessible/root)
  while ((queue_index < ${#queue[@]} && queue_index < 200)); do
    object_path=${queue[$queue_index]}
    ((queue_index++))

    name_reply=$(gdbus call --address "$a11y_address" \
      --dest "$app_bus" \
      --object-path "$object_path" \
      --method org.freedesktop.DBus.Properties.Get \
      org.a11y.atspi.Accessible Name 2>/dev/null) || continue
    role_reply=$(gdbus call --address "$a11y_address" \
      --dest "$app_bus" \
      --object-path "$object_path" \
      --method org.a11y.atspi.Accessible.GetRoleName 2>/dev/null) || continue

    accessible_name=${name_reply#*<\'}
    accessible_name=${accessible_name%%\'*}
    if [[ $role_reply == *button* ]]; then
      case $accessible_name in
      Select | Open | Choose | اختيار | فتح)
        action_reply=$(gdbus call --address "$a11y_address" \
          --dest "$app_bus" \
          --object-path "$object_path" \
          --method org.a11y.atspi.Action.DoAction 0 2>/dev/null) || return 1
        [[ $action_reply == *true* ]]
        return
        ;;
      esac
    fi

    children=$(gdbus call --address "$a11y_address" \
      --dest "$app_bus" \
      --object-path "$object_path" \
      --method org.a11y.atspi.Accessible.GetChildren 2>/dev/null) || continue
    while read -r child_object; do
      [[ -n $child_object ]] && queue+=("$child_object")
    done < <(
      printf '%s\n' "$children" |
        grep -oE '/org/a11y/atspi/accessible/[[:alnum:]_-]+' |
        awk '!seen[$0]++'
    )
  done

  return 1
}

trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

for arg in "$@"; do
  case $arg in
  --private) PRIVATE=true ;;
  smart | region | windows | fullscreen) MODE=$arg ;;
  *)
    echo "Usage: omarchy-capture-image-search [--private] [smart|region|windows|fullscreen]" >&2
    exit 2
    ;;
  esac
done

# Match the stock screenshot command: pressing another capture shortcut while
# a selector is already open dismisses that selector instead of stacking two.
pkill slurp && exit 0

CURSOR_SETTING=$(hyprctl getoption cursor:no_hardware_cursors -j 2>/dev/null | jq -r '.int // empty')
if [[ -n $CURSOR_SETTING ]] && set_no_hardware_cursors 0; then
  CURSOR_CHANGED=true
fi

{ read -r FREEZE_PID; read -r SELECTION; } < <(omarchy-capture-region "$MODE" --keep-freeze)
[[ -n ${SELECTION:-} ]] || exit 0

RUNTIME_DIR=${XDG_RUNTIME_DIR:-/tmp}
CAPTURE_FILE=$(mktemp --tmpdir="$RUNTIME_DIR" omarchy-image-search.XXXXXX.png) || {
  release_capture_state
  notify_failure "Could not create a temporary capture"
  exit 1
}

if ! grim -g "$SELECTION" "$CAPTURE_FILE" || [[ ! -s $CAPTURE_FILE ]]; then
  release_capture_state
  notify_failure "Could not capture the selected region"
  exit 1
fi

# The image is complete now; restore the desktop before doing any networking.
release_capture_state

if ! command -v wtype >/dev/null; then
  notify_failure "Keyboard automation is unavailable (wtype is missing)"
  exit 1
fi

BEFORE_BROWSER=$(client_addresses)

if [[ $PRIVATE == true ]]; then
  BROWSER_ARGS=(--private --new-window "https://www.google.com/")
else
  BROWSER_ARGS=(--new-window "https://www.google.com/")
fi

if ! omarchy-launch-browser "${BROWSER_ARGS[@]}"; then
  notify_failure "Could not open the default browser"
  exit 1
fi

for _ in {1..120}; do
  BROWSER_ADDRESS=$(new_browser_address "$BEFORE_BROWSER")
  [[ -n $BROWSER_ADDRESS ]] && break
  sleep .05
done

if [[ -z $BROWSER_ADDRESS ]]; then
  notify_failure "Could not find the new browser window"
  exit 1
fi

# Wait for Google rather than sending keys into a still-empty browser window.
for _ in {1..200}; do
  TITLE=$(window_title "$BROWSER_ADDRESS")
  [[ $TITLE == *Google* ]] && break
  sleep .05
done

if [[ $TITLE != *Google* ]]; then
  notify_failure "Google did not finish loading"
  exit 1
fi

if ! focus_window "$BROWSER_ADDRESS"; then
  notify_failure "Could not focus the browser"
  exit 1
fi

# Activate Google's language-independent Lens control in the loaded page. A
# typed javascript: URL runs in the current tab without a new network request.
sleep .5
wtype -M ctrl -k l -m ctrl
wtype "javascript:document.querySelector('[jsname=R5mgy]').click()"
wtype -k return
sleep .5

BEFORE_CHOOSER=$(client_addresses)
wtype -k return

for _ in {1..160}; do
  CHOOSER_ADDRESS=$(new_chooser_address "$BEFORE_CHOOSER")
  [[ -n $CHOOSER_ADDRESS ]] && break
  sleep .05
done

if [[ -z $CHOOSER_ADDRESS ]]; then
  notify_failure "Google Lens did not open the file chooser"
  exit 1
fi

if ! focus_window "$CHOOSER_ADDRESS"; then
  notify_failure "Could not focus the file chooser"
  exit 1
fi

# GTK's location entry accepts an exact path; the accessibility action then
# activates the real Select button without coordinates or localized tab order.
wtype -M ctrl -k l -m ctrl
sleep .1
wtype "$CAPTURE_FILE"
wtype -k return
sleep .25

if ! activate_chooser_select; then
  notify_failure "Could not activate the file chooser's Select button"
  exit 1
fi

for _ in {1..200}; do
  window_exists "$CHOOSER_ADDRESS" || break
  sleep .05
done

if window_exists "$CHOOSER_ADDRESS"; then
  notify_failure "Could not submit the captured image"
  exit 1
fi

# The browser has consumed the file by the time the chooser closes.
sleep .25
